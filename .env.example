# ==============================================================================
# CareBridge — Hospital Management & Clinical Coordination Platform
# Environment Configuration Template
# ==============================================================================
#
# SECURITY NOTICE:
# - Use ONLY the public Anonymous/Publishable key for frontend builds.
# - NEVER expose the Supabase service_role key, database connection passwords,
#   or private JWT secrets in frontend environment variables or client code.
# - Never commit real credentials or .env files to version control.
# ==============================================================================

# Supabase Project Connection
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Application Data Mode:
# Set to 'false' for strict production live database connectivity.
# Set to 'true' for local university demonstration mode with fallback simulation data.
VITE_USE_MOCK_FALLBACK=false

# Private Storage Bucket Configuration
# Default: medical-reports (configured via supabase/migrations/003_storage_buckets.sql)
VITE_STORAGE_BUCKET_REPORTS=medical-reports

# Server & Application Branding
VITE_APP_NAME="CareBridge Hospital Management System"
VITE_APP_VERSION="1.2.0"
